#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/timedesk/timedesk /usr/bin/timedesk

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/timedesk.service ]; then
			rm -f /etc/systemd/system/timedesk.service /usr/lib/systemd/system/timedesk.service /usr/lib/systemd/user/timedesk.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/timedesk/files/systemd/timedesk.service /usr/lib/systemd/system/timedesk.service
		# try fix error in Ubuntu 18.04
		# Failed to reload timedesk.service: Unit timedesk.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/timedesk.service:10: Executable path is not absolute: pkill -f "timedesk --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/timedesk.service
		fi
		systemctl daemon-reload
		systemctl enable timedesk
		systemctl start timedesk
	fi
fi
